# ── Vercel KV (copy from your Vercel dashboard → Storage → KV) ──────────────
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ── Cron security (generate any random string, paste into Vercel env too) ────
CRON_SECRET=your_random_secret_here

# ── Public (exposed to browser — keep empty or same as CRON_SECRET for manual trigger) ──
NEXT_PUBLIC_CRON_SECRET=your_random_secret_here
